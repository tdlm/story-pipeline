{
  "name": "story-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Script a scene in YAML, get a narrated story video with consistent characters and voices.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "render": "node --disable-warning=ExperimentalWarning src/cli.ts render",
    "fix": "node --disable-warning=ExperimentalWarning src/cli.ts fix",
    "keep": "node --disable-warning=ExperimentalWarning src/cli.ts keep",
    "voices": "node --disable-warning=ExperimentalWarning src/cli.ts voices",
    "preflight": "node --disable-warning=ExperimentalWarning src/cli.ts preflight",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "studio": "node --disable-warning=ExperimentalWarning studio/dev.ts",
    "studio:build": "next build studio/web",
    "spike:agent": "node --disable-warning=ExperimentalWarning studio/spikes/agent-sdk.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "hono": "^4.13.17",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
