# Copy to .env and paste your keys. .env is gitignored.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Only needed if a cast uses cartesia: voices
CARTESIA_API_KEY=

# Optional overrides (defaults shown). Run `pnpm preflight` to see which models your key can use.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_CHECK_MODEL=gemini-3-flash-preview
# GEMINI_IMAGE_SIZE=2K
# IMAGE_MAX_ATTEMPTS=2
# IMAGE_COST_USD=0.1
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_DRAFT_MODEL=eleven_flash_v2_5
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VERSION=2026-08-14
# CAPTION_FONT=Impact
# Only if ffmpeg-full lives somewhere else:
# FFMPEG_DIR=/opt/homebrew/opt/ffmpeg-full/bin
